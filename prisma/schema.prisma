generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
  CLINIC_MANAGER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

enum DocumentKind {
  MEDICAL
  LAB_RESULT
  CERTIFICATE
  OTHER
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  users       User[]
  permissions Permission[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  roles Role[]
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  phone             String?        @unique
  passwordHash      String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?      @db.Date
  avatarUrl         String?
  isActive          Boolean        @default(true)
  emailVerifiedAt   DateTime?
  roleId            String
  role              Role           @relation(fields: [roleId], references: [id])
  patient           Patient?
  doctor            Doctor?
  managedClinics    Clinic[]       @relation("ClinicManager")
  notifications     Notification[]
  adminLogs         AdminLog[]     @relation("AdminActor")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([roleId])
  @@index([createdAt])
}

model Patient {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  records      MedicalRecord[]
  documents    MedicalDocument[]
  reviews      Review[]
}

model Specialization {
  id      String   @id @default(cuid())
  name    String   @unique
  doctors Doctor[]
}

model Doctor {
  id               String           @id @default(cuid())
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  specializationId String
  specialization   Specialization   @relation(fields: [specializationId], references: [id])
  experienceYears  Int              @default(0)
  price            Int
  imageUrl         String           @default("")
  education        String           @default("")
  about            String           @default("")
  workDays         Int[]            @default([])
  startTime        String           @default("09:00")
  endTime          String           @default("17:00")
  isActive         Boolean          @default(true)
  featured         Boolean          @default(false)
  clinics          ClinicDoctor[]
  schedules        DoctorSchedule[]
  appointments     Appointment[]
  records          MedicalRecord[]
  reviews          Review[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([fullName])
  @@index([specializationId, isActive])
}

model Clinic {
  id          String          @id @default(cuid())
  name        String
  city        String
  address     String
  phone       String
  email       String?
  description String          @default("")
  logoUrl     String?
  imageUrls   String[]        @default([])
  openingHours Json?
  managerId   String?
  manager     User?           @relation("ClinicManager", fields: [managerId], references: [id])
  doctors     ClinicDoctor[]
  services    ClinicService[]
  appointments Appointment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([city, name])
  @@index([managerId])
}

model ClinicDoctor {
  clinicId String
  doctorId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@id([clinicId, doctorId])
}

model Service {
  id          String          @id @default(cuid())
  name        String          @unique
  description String          @default("")
  clinics     ClinicService[]
}

model ClinicService {
  clinicId  String
  serviceId String
  price     Int?
  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([clinicId, serviceId])
}

model DoctorSchedule {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId, dayOfWeek])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  clinicId    String?
  clinic      Clinic?           @relation(fields: [clinicId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  reason      String            @default("")
  status      AppointmentStatus @default(PENDING)
  records     MedicalRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, startsAt])
}

model MedicalRecord {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  diagnosis     String?
  conclusion    String?
  recommendations String?
  documents     MedicalDocument[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([patientId, createdAt])
  @@index([doctorId, patientId])
}

model MedicalDocument {
  id          String         @id @default(cuid())
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id])
  recordId    String?
  record      MedicalRecord? @relation(fields: [recordId], references: [id])
  kind        DocumentKind
  fileName    String
  storageKey  String         @unique
  mimeType    String
  byteSize    Int
  createdAt   DateTime       @default(now())

  @@index([patientId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AdminActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
